<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formato 80mm para el ticket de la nota de venta. -->
    <record id="paperformat_nota_venta_ticket" model="report.paperformat">
        <field name="name">Nota de venta ticket 80mm</field>
        <field name="format">custom</field>
        <field name="page_width">80</field>
        <!-- Alto CONCRETO (no 0): con page_height=0 Odoo omite el arg de alto y wkhtmltopdf cae a A4
             (el ticket "flotaba" arriba-izquierda de una hoja gigante). 150mm cubre la gran mayoría
             de tickets en una pagina; los muy largos paginan (normal en rollo termico). -->
        <field name="page_height">150</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="dpi">96</field>
    </record>

    <!-- Reporte PDF A4 de la nota de venta (QWeb). Documento INTERNO, NO CPE. -->
    <record id="action_report_nota_venta" model="ir.actions.report">
        <field name="name">Nota de venta</field>
        <field name="model">l10n_pe_ne.nota_venta</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_pe_ne_biller.report_nota_venta</field>
        <field name="report_file">l10n_pe_ne_biller.report_nota_venta</field>
        <field name="print_report_name">'Nota de venta - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_l10n_pe_ne_nota_venta"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Reporte PDF ticket 80mm de la nota de venta. -->
    <record id="action_report_nota_venta_ticket" model="ir.actions.report">
        <field name="name">Nota de venta (ticket)</field>
        <field name="model">l10n_pe_ne.nota_venta</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_pe_ne_biller.report_nota_venta_ticket</field>
        <field name="report_file">l10n_pe_ne_biller.report_nota_venta_ticket</field>
        <field name="paperformat_id" ref="paperformat_nota_venta_ticket"/>
    </record>

    <!-- ============================== A4 ============================== -->
    <template id="report_nota_venta">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <style>
                        .page table, .page thead, .page tbody, .page tfoot, .page tr, .page td, .page th { border: none; }
                    </style>
                    <div class="page" style="font-family: Arial, Helvetica, sans-serif; color:#1f2937; font-size:12px;">
                        <t t-set="sym" t-value="o.currency_id.symbol or o.currency_id.name"/>
                        <t t-set="a_pagar" t-value="round((o.amount_total or 0) + (o.redondeo or 0), 2)"/>
                        <t t-set="pagado" t-value="sum(float(m.get('monto') or 0) for m in (o.medios_pago or []))"/>
                        <t t-set="vuelto" t-value="round(pagado - a_pagar, 2)"/>

                        <!-- LEYENDA LEGAL (obligatoria): la nota de venta NO es un comprobante SUNAT. -->
                        <div style="background:#fef3c7; border:1px solid #f59e0b; border-radius:8px; padding:8px 14px; margin-bottom:14px; text-align:center; font-size:11px; font-weight:bold; color:#92400e; letter-spacing:.03em;">
                            NOTA DE VENTA — DOCUMENTO INTERNO · SIN VALOR TRIBUTARIO · NO ES COMPROBANTE DE PAGO
                        </div>

                        <!-- Cabecera: emisor · panel NOTA DE VENTA -->
                        <table class="o_ignore_layout_styling" style="width:100%; border-collapse:collapse;">
                            <tr>
                                <td style="border:0; vertical-align:top; width:58%;">
                                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)"
                                         style="max-height:66px; max-width:230px; margin-bottom:8px;"/>
                                    <div style="font-size:15px; font-weight:bold;" t-esc="o.company_id.name"/>
                                    <div t-if="o.company_id.vat" style="font-size:11px; color:#6b7280;">RUC: <span t-esc="o.company_id.vat"/></div>
                                    <div t-if="o.company_id.street" style="font-size:11px; color:#6b7280;">
                                        <span t-esc="o.company_id.street"/><t t-if="o.company_id.city">, <span t-esc="o.company_id.city"/></t>
                                    </div>
                                </td>
                                <td style="border:0; vertical-align:top; width:42%; text-align:right;">
                                    <div style="display:inline-block; border:1px solid #cbd5e1; border-top:3px solid #334155; border-radius:10px; padding:12px 20px; text-align:center; min-width:214px; background:#ffffff;">
                                        <div style="color:#334155; font-weight:bold; font-size:16px; letter-spacing:.6px;">NOTA DE VENTA</div>
                                        <div style="font-size:15px; font-weight:bold; margin-top:2px;" t-esc="o.name"/>
                                        <div style="border-top:1px solid #e2e8f0; margin:8px 0 6px;"/>
                                        <table class="o_ignore_layout_styling" style="width:100%; border-collapse:collapse; font-size:11px; color:#4b5563;">
                                            <tr>
                                                <td style="border:0; padding:2px 0; text-align:left; color:#64748b;">Fecha</td>
                                                <td style="border:0; padding:2px 0; text-align:right;"><span t-esc="o.fecha.strftime('%d/%m/%Y') if o.fecha else ''"/></td>
                                            </tr>
                                            <tr>
                                                <td style="border:0; padding:2px 0; text-align:left; color:#64748b;">Moneda</td>
                                                <td style="border:0; padding:2px 0; text-align:right;"><span t-esc="o.currency_id.name"/></td>
                                            </tr>
                                            <tr t-if="o.create_uid">
                                                <td style="border:0; padding:2px 0; text-align:left; color:#64748b;">Atendido por</td>
                                                <td style="border:0; padding:2px 0; text-align:right;"><span t-esc="o.create_uid.name"/></td>
                                            </tr>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Cliente (opcional) -->
                        <div style="margin-top:20px; background:#f1f5f9; border:1px solid #e2e8f0; padding:11px 15px; border-radius:8px;">
                            <div style="font-size:10px; text-transform:uppercase; letter-spacing:.08em; color:#64748b; margin-bottom:2px;">Cliente</div>
                            <div style="font-weight:bold;">
                                <span t-esc="o.partner_id.name or o.cliente_nombre or 'Cliente varios'"/>
                                <t t-if="o.partner_id.vat"> · <span t-esc="o.partner_id.vat"/></t>
                            </div>
                        </div>

                        <!-- Detalle -->
                        <table class="o_ignore_layout_styling" style="width:100%; border-collapse:collapse; margin-top:18px; font-size:12px;">
                            <thead>
                                <tr>
                                    <th style="border:0; background:#334155; color:#ffffff; text-align:center; padding:8px 6px; width:28px; border-radius:6px 0 0 0;">N°</th>
                                    <th style="border:0; background:#334155; color:#ffffff; text-align:left; padding:8px 10px;">Descripción</th>
                                    <th style="border:0; background:#334155; color:#ffffff; text-align:right; padding:8px 8px; width:54px;">Cant.</th>
                                    <th style="border:0; background:#334155; color:#ffffff; text-align:center; padding:8px 8px; width:50px;">Und.</th>
                                    <th style="border:0; background:#334155; color:#ffffff; text-align:right; padding:8px 8px; width:92px;">P. Unit.</th>
                                    <th style="border:0; background:#334155; color:#ffffff; text-align:right; padding:8px 10px; width:104px; border-radius:0 6px 0 0;">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="l" t-att-style="'background:#f8fafc;' if l_index % 2 else ''">
                                    <td style="border:0; border-bottom:1px solid #eef2f6; text-align:center; padding:7px 6px; color:#94a3b8;" t-esc="l_index + 1"/>
                                    <td style="border:0; border-bottom:1px solid #eef2f6; padding:7px 10px;">
                                        <span t-esc="l.descripcion"/>
                                        <t t-if="not l.afecto_igv"><span style="font-size:10px; color:#94a3b8;"> (no gravado)</span></t>
                                    </td>
                                    <td style="border:0; border-bottom:1px solid #eef2f6; text-align:right; padding:7px 8px;" t-esc="'%.2f' % l.cantidad"/>
                                    <td style="border:0; border-bottom:1px solid #eef2f6; text-align:center; padding:7px 8px; color:#6b7280;" t-esc="l.product_id.l10n_pe_ne_unit_code or 'NIU'"/>
                                    <td style="border:0; border-bottom:1px solid #eef2f6; text-align:right; padding:7px 8px;"><span t-esc="sym"/> <span t-esc="'%.2f' % l.precio_unitario"/></td>
                                    <td style="border:0; border-bottom:1px solid #eef2f6; text-align:right; padding:7px 10px; font-weight:600;"><span t-esc="sym"/> <span t-esc="'%.2f' % l.subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Pago (izquierda) · totales (derecha) -->
                        <table class="o_ignore_layout_styling" style="width:100%; margin-top:18px; border-collapse:collapse;">
                            <tr>
                                <td style="border:0; vertical-align:top; width:56%; padding-right:20px;">
                                    <t t-if="o.medios_pago">
                                        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:10px 14px;">
                                            <div style="font-size:10px; text-transform:uppercase; letter-spacing:.08em; color:#64748b; margin-bottom:6px;">Forma de pago</div>
                                            <table class="o_ignore_layout_styling" style="width:100%; border-collapse:collapse; font-size:11px; color:#4b5563;">
                                                <tr t-foreach="o.medios_pago" t-as="m">
                                                    <td style="border:0; padding:2px 8px 2px 0; color:#64748b;"><span t-esc="m.get('medio') or ''"/></td>
                                                    <td style="border:0; padding:2px 0; text-align:right; font-weight:600;"><span t-esc="sym"/> <span t-esc="'%.2f' % float(m.get('monto') or 0)"/></td>
                                                </tr>
                                                <tr t-if="o.redondeo">
                                                    <td style="border:0; padding:2px 8px 2px 0; color:#64748b;">A pagar efectivo</td>
                                                    <td style="border:0; padding:2px 0; text-align:right; font-weight:600;"><span t-esc="sym"/> <span t-esc="'%.2f' % a_pagar"/></td>
                                                </tr>
                                                <tr t-if="vuelto &gt; 0">
                                                    <td style="border:0; padding:2px 8px 2px 0; color:#64748b;">Vuelto</td>
                                                    <td style="border:0; padding:2px 0; text-align:right; font-weight:600;"><span t-esc="sym"/> <span t-esc="'%.2f' % vuelto"/></td>
                                                </tr>
                                            </table>
                                        </div>
                                    </t>
                                    <t t-if="o.notas">
                                        <div style="font-size:10px; text-transform:uppercase; letter-spacing:.08em; color:#64748b; margin:10px 0 3px;">Notas</div>
                                        <div style="font-size:11px; color:#4b5563; white-space:pre-line;" t-esc="o.notas"/>
                                    </t>
                                </td>
                                <td style="border:0; vertical-align:top; width:44%;">
                                    <table class="o_ignore_layout_styling" style="width:100%; border-collapse:collapse; font-size:12px;">
                                        <tr t-if="o.amount_op_gravada">
                                            <td style="border:0; border-bottom:1px solid #eef2f6; padding:5px 0; color:#6b7280;">Op. gravada</td>
                                            <td style="border:0; border-bottom:1px solid #eef2f6; padding:5px 0; text-align:right;"><span t-esc="sym"/> <span t-esc="'%.2f' % o.amount_op_gravada"/></td>
                                        </tr>
                                        <tr t-if="o.amount_op_no_gravada">
                                            <td style="border:0; border-bottom:1px solid #eef2f6; padding:5px 0; color:#6b7280;">Op. exonerada / inafecta</td>
                                            <td style="border:0; border-bottom:1px solid #eef2f6; padding:5px 0; text-align:right;"><span t-esc="sym"/> <span t-esc="'%.2f' % o.amount_op_no_gravada"/></td>
                                        </tr>
                                        <tr>
                                            <td style="border:0; padding:5px 0; color:#6b7280;">IGV (18%)</td>
                                            <td style="border:0; padding:5px 0; text-align:right;"><span t-esc="sym"/> <span t-esc="'%.2f' % o.amount_tax"/></td>
                                        </tr>
                                        <tr>
                                            <td style="border:0; background:#f1f5f9; border-radius:8px 0 0 8px; padding:8px 0 8px 12px; font-weight:bold; font-size:14px; color:#0f172a;">Total <span t-esc="o.currency_id.name"/></td>
                                            <td style="border:0; background:#f1f5f9; border-radius:0 8px 8px 0; text-align:right; padding:8px 12px 8px 0; font-weight:bold; font-size:14px; color:#334155;"><span t-esc="sym"/> <span t-esc="'%.2f' % o.amount_total"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Pie (leyenda legal repetida) -->
                        <div style="margin-top:30px; border-top:1px solid #eef2f6; padding-top:10px; font-size:10px; color:#94a3b8; text-align:center;">
                            Documento interno de control. Una NOTA DE VENTA no es un comprobante de pago electrónico y NO tiene validez tributaria ante SUNAT.
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================ TICKET 80mm ============================ -->
    <!-- basic_layout: necesario para el charset UTF-8 (html_container solo produce mojibake en á/·).
         NADA de <table>: el CSS de reportes de Odoo (report_assets_common) bordea las celdas y hace
         parecer planilla. Se maquetan las filas con <div> + float:right + overflow:hidden (patrón
         100% soportado por wkhtmltopdf, inmune a cualquier CSS de tablas). -->
    <template id="report_nota_venta_ticket">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                <t t-set="sym" t-value="o.currency_id.symbol or o.currency_id.name"/>
                <t t-set="a_pagar" t-value="round((o.amount_total or 0) + (o.redondeo or 0), 2)"/>
                <t t-set="pagado" t-value="sum(float(m.get('monto') or 0) for m in (o.medios_pago or []))"/>
                <t t-set="vuelto" t-value="round(pagado - a_pagar, 2)"/>
                <div class="page" style="font-family:'DejaVu Sans',Arial,sans-serif; color:#000; width:100%; font-size:11px; line-height:1.35;">
                    <!-- Encabezado del negocio -->
                    <div style="text-align:center;">
                        <div style="font-weight:bold; font-size:14px;" t-esc="o.company_id.name"/>
                        <div t-if="o.company_id.vat" style="font-size:11px;">RUC <span t-esc="o.company_id.vat"/></div>
                        <div t-if="o.company_id.street" style="font-size:10px; color:#333;" t-esc="o.company_id.street"/>
                        <div style="margin:6px 0 3px; font-weight:bold; font-size:12px; letter-spacing:0.5px;">NOTA DE VENTA</div>
                        <div style="font-weight:bold; font-size:13px;" t-esc="o.name"/>
                        <div style="font-size:10px;" t-esc="o.fecha.strftime('%d/%m/%Y') if o.fecha else ''"/>
                    </div>
                    <div style="border-top:1px dashed #000; margin:6px 0 4px;"/>
                    <div style="font-size:10px;">Cliente: <span t-esc="o.partner_id.name or o.cliente_nombre or 'Cliente varios'"/><t t-if="o.partner_id.vat"> · <span t-esc="o.partner_id.vat"/></t></div>
                    <div style="border-top:1px dashed #000; margin:4px 0;"/>
                    <!-- Ítems: descripción arriba; luego "cantidad x P.U." a la izq. y subtotal a la der. -->
                    <t t-foreach="o.line_ids" t-as="l">
                        <t t-set="qty" t-value="('%d' % l.cantidad) if l.cantidad == int(l.cantidad) else ('%.3f' % l.cantidad).rstrip('0').rstrip('.')"/>
                        <div style="margin-top:3px; font-size:10px;" t-esc="l.descripcion"/>
                        <div style="overflow:hidden; font-size:10px; color:#333;">
                            <span style="float:right; font-weight:bold; color:#000; white-space:nowrap;"><span t-esc="sym"/> <span t-esc="'%.2f' % l.subtotal"/></span>
                            <span t-esc="qty"/> x <span t-esc="sym"/> <span t-esc="'%.2f' % l.precio_unitario"/><t t-if="not l.afecto_igv"> <span style="color:#888;">(no grav.)</span></t>
                        </div>
                    </t>
                    <div style="border-top:1px dashed #000; margin:4px 0;"/>
                    <!-- Totales -->
                    <div t-if="o.amount_op_gravada" style="overflow:hidden;"><span style="float:right;"><span t-esc="sym"/> <span t-esc="'%.2f' % o.amount_op_gravada"/></span>Op. gravada</div>
                    <div t-if="o.amount_op_no_gravada" style="overflow:hidden;"><span style="float:right;"><span t-esc="sym"/> <span t-esc="'%.2f' % o.amount_op_no_gravada"/></span>Op. no gravada</div>
                    <div t-if="o.amount_tax" style="overflow:hidden;"><span style="float:right;"><span t-esc="sym"/> <span t-esc="'%.2f' % o.amount_tax"/></span>IGV (18%)</div>
                    <div style="overflow:hidden; border-top:1px solid #000; margin-top:2px; padding-top:2px; font-weight:bold; font-size:13px;"><span style="float:right;"><span t-esc="sym"/> <span t-esc="'%.2f' % o.amount_total"/></span>TOTAL</div>
                    <!-- Pago recibido + vuelto -->
                    <div style="border-top:1px dashed #000; margin:5px 0 4px;"/>
                    <t t-foreach="o.medios_pago" t-as="m">
                        <div style="overflow:hidden; font-size:10px;"><span style="float:right;"><span t-esc="sym"/> <span t-esc="'%.2f' % float(m.get('monto') or 0)"/></span><span t-esc="m.get('medio') or 'Efectivo'"/></div>
                    </t>
                    <div t-if="o.redondeo" style="overflow:hidden; font-size:10px;"><span style="float:right;"><span t-esc="sym"/> <span t-esc="'%.2f' % a_pagar"/></span>A pagar (efectivo)</div>
                    <div t-if="vuelto &gt; 0" style="overflow:hidden; font-weight:bold;"><span style="float:right;"><span t-esc="sym"/> <span t-esc="'%.2f' % vuelto"/></span>Vuelto</div>
                    <!-- Leyenda legal (obligatoria: no es CPE) -->
                    <div style="border:1.5px solid #000; text-align:center; font-weight:bold; font-size:10px; margin:8px 0 4px; padding:3px;">SIN VALOR TRIBUTARIO<br/>NO ES COMPROBANTE DE PAGO</div>
                    <div style="text-align:center; font-size:9px; color:#555;">Documento interno · no válido ante SUNAT</div>
                    <div t-if="o.notas" style="border-top:1px dashed #000; margin:5px 0 0; font-size:9px; color:#555;"><span t-esc="o.notas"/></div>
                </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
